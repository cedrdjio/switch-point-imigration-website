---
import type { Destination } from '@/data/destinations';
import Icon from '@/components/Icon.astro';
import Flag from '@/components/Flag.astro';

interface Props {
  destination: Destination;
  size?: 'md' | 'lg';
}
const { destination: d, size = 'md' } = Astro.props;
---

<a
  href={`/${d.slug}`}
  class={`bento bento-hover group flex flex-col justify-end ${size === 'lg' ? 'min-h-[340px]' : 'min-h-[260px]'}`}
  data-reveal-item
>
  <!-- Photo plein cadre -->
  <div class="media-parallax absolute inset-0">
    <img
      src={d.image}
      alt={`Paysage — ${d.name}`}
      loading="lazy"
      data-fallback
      class="transition-transform duration-700 group-hover:scale-105"
    />
  </div>
  <div class="absolute inset-0 bg-gradient-to-t from-navy-950/92 via-navy-950/35 to-navy-950/10 transition-opacity duration-500"></div>

  <!-- Badge région -->
  <span class="badge-navy absolute top-4 left-4">{d.region}</span>

  <!-- Contenu -->
  <div class={`relative text-white ${size === 'lg' ? 'p-7' : 'p-6'}`}>
    <div class="flex items-center gap-2.5">
      <Flag cc={d.cc} class="h-[16px] w-[22px]" />
      <h3 class={`font-display font-bold tracking-tight ${size === 'lg' ? 'text-2xl' : 'text-xl'}`}>
        {d.name}
      </h3>
    </div>
    <p class="mt-1.5 text-sm leading-snug text-white/75">{d.tagline}</p>
    <div class="mt-4 flex items-center justify-between">
      <span class="text-xs font-bold text-white/60">
        {d.programs.length} programme{d.programs.length > 1 ? 's' : ''}
      </span>
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-accent-400 text-navy-900 transition-transform duration-300 group-hover:translate-x-1">
        <Icon name="ArrowRight" class="h-4 w-4" />
      </span>
    </div>
  </div>
</a>
