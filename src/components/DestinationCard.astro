---
import type { Destination } from '@/data/destinations';

interface Props {
  destination: Destination;
  size?: 'md' | 'lg';
}
const { destination: d, size = 'md' } = Astro.props;
---

<a
  href={`/${d.slug}`}
  class={`bento bento-hover group flex flex-col justify-between ${size === 'lg' ? 'p-8 min-h-[280px]' : 'p-6 min-h-[220px]'}`}
  data-reveal-item
>
  <div class={`pointer-events-none absolute inset-0 bg-gradient-to-br opacity-60 transition-opacity duration-500 group-hover:opacity-100 ${d.gradient}`}></div>
  <div class="relative flex items-start justify-between">
    <span class={size === 'lg' ? 'text-5xl' : 'text-4xl'}>{d.flag}</span>
    <span class="badge">{d.region}</span>
  </div>
  <div class="relative mt-6">
    <h3 class={`font-display font-bold tracking-tight text-navy-900 dark:text-white ${size === 'lg' ? 'text-2xl' : 'text-xl'}`}>
      {d.name}
    </h3>
    <p class="mt-1.5 text-sm leading-snug text-navy-900/55 dark:text-white/50">{d.tagline}</p>
    <div class="mt-4 flex items-center justify-between">
      <span class="text-xs font-semibold text-navy-900/45 dark:text-white/40">
        {d.programs.length} programme{d.programs.length > 1 ? 's' : ''}
      </span>
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-700 text-white transition-transform duration-300 group-hover:translate-x-1 group-hover:bg-brand-600">
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10m-4-4 4 4-4 4"/></svg>
      </span>
    </div>
  </div>
</a>
