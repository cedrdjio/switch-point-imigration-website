---
import { SITE } from '@/data/site';
import { destinations, regions } from '@/data/destinations';
import { tools } from '@/data/tools';
import Icon from '@/components/Icon.astro';
import Flag from '@/components/Flag.astro';

const byRegion = regions.map((r) => ({
  region: r,
  items: destinations.filter((d) => d.region === r),
}));

const resources = [
  { href: '/blog', icon: 'Newspaper', name: 'Blog & actualités', desc: 'Guides et nouvelles de l’immigration' },
  { href: '/blog#guides', icon: 'BookOpen', name: 'Guides pratiques', desc: 'Procédures expliquées pas à pas' },
  { href: '/#faq', icon: 'CircleHelp', name: 'Questions fréquentes', desc: 'Les réponses à vos questions' },
  { href: '/a-propos', icon: 'Compass', name: 'Notre méthode', desc: 'Comment nous travaillons' },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500 [&.is-scrolled]:py-2 py-4"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <nav
      class="glass flex items-center justify-between gap-4 rounded-2xl px-4 py-2.5 shadow-soft sm:px-5"
      aria-label="Navigation principale"
    >
      <!-- Logo -->
      <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={SITE.name}>
        <img src="/images/logo.png" alt="" width="38" height="38" class="h-9 w-9 object-contain" />
        <span class="hidden flex-col leading-tight sm:flex">
          <span class="font-display text-[15px] font-bold tracking-tight text-navy-900 dark:text-white"
            >SwitchPoint</span
          >
          <span class="text-[10px] font-bold tracking-[0.18em] uppercase text-accent-600 dark:text-accent-400"
            >Immigration Agency</span
          >
        </span>
      </a>

      <!-- Nav desktop -->
      <div class="hidden items-center gap-1 lg:flex">
        <a href="/" class="btn-ghost btn rounded-xl px-3.5 py-2 text-sm">Accueil</a>

        <!-- Destinations mega menu -->
        <div class="relative" data-menu>
          <button
            data-menu-btn
            aria-expanded="false"
            class="btn-ghost btn rounded-xl px-3.5 py-2 text-sm"
          >
            Destinations
            <Icon name="ChevronDown" class="h-3.5 w-3.5 opacity-60" />
          </button>
          <div
            data-menu-panel
            class="invisible absolute left-1/2 top-full z-50 mt-3 w-[720px] -translate-x-1/2 translate-y-2 opacity-0 transition-all duration-300 [&.is-open]:visible [&.is-open]:translate-y-0 [&.is-open]:opacity-100"
          >
            <div class="glass rounded-3xl p-6 shadow-lift">
              <div class="grid grid-cols-3 gap-6">
                {
                  byRegion.map(({ region, items }) => (
                    <div>
                      <p class="eyebrow mb-3 text-[10px]">{region}</p>
                      <ul class="space-y-1">
                        {items.map((d) => (
                          <li>
                            <a
                              href={`/${d.slug}`}
                              class="group flex items-start gap-2.5 rounded-xl p-2 transition-colors hover:bg-accent-400/10"
                            >
                              <span class="mt-1"><Flag cc={d.cc} /></span>
                              <span>
                                <span class="block text-sm font-semibold text-navy-900 group-hover:text-brand-800 dark:text-white dark:group-hover:text-accent-300">
                                  {d.name}
                                </span>
                                <span class="block text-[11px] leading-tight text-navy-900/45 dark:text-white/40">
                                  {d.programs.length} programme{d.programs.length > 1 ? 's' : ''}
                                </span>
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
              <a
                href="/destinations"
                class="mt-5 flex items-center justify-between rounded-2xl bg-brand-900 px-5 py-3.5 text-sm font-bold text-white transition-transform hover:scale-[1.01]"
              >
                <span>Explorer toutes les destinations</span>
                <Icon name="ArrowRight" class="h-4 w-4 text-accent-400" />
              </a>
            </div>
          </div>
        </div>

        <!-- Outils mega menu -->
        <div class="relative" data-menu>
          <button data-menu-btn aria-expanded="false" class="btn-ghost btn rounded-xl px-3.5 py-2 text-sm">
            Outils
            <Icon name="ChevronDown" class="h-3.5 w-3.5 opacity-60" />
          </button>
          <div
            data-menu-panel
            class="invisible absolute left-1/2 top-full z-50 mt-3 w-[560px] -translate-x-1/2 translate-y-2 opacity-0 transition-all duration-300 [&.is-open]:visible [&.is-open]:translate-y-0 [&.is-open]:opacity-100"
          >
            <div class="glass rounded-3xl p-5 shadow-lift">
              <div class="grid grid-cols-2 gap-1.5">
                {
                  tools.map((t) => (
                    <a
                      href={`/outils/${t.slug}`}
                      class="group flex items-start gap-3 rounded-2xl p-3 transition-colors hover:bg-accent-400/10"
                    >
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand-900 text-accent-400">
                        <Icon name={t.icon} class="h-4.5 w-4.5" />
                      </span>
                      <span>
                        <span class="block text-sm font-semibold text-navy-900 group-hover:text-brand-800 dark:text-white dark:group-hover:text-accent-300">
                          {t.name}
                        </span>
                        <span class="mt-0.5 block text-[11px] leading-snug text-navy-900/45 dark:text-white/40">
                          {t.short}
                        </span>
                      </span>
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <!-- Ressources -->
        <div class="relative" data-menu>
          <button data-menu-btn aria-expanded="false" class="btn-ghost btn rounded-xl px-3.5 py-2 text-sm">
            Ressources
            <Icon name="ChevronDown" class="h-3.5 w-3.5 opacity-60" />
          </button>
          <div
            data-menu-panel
            class="invisible absolute left-1/2 top-full z-50 mt-3 w-[340px] -translate-x-1/2 translate-y-2 opacity-0 transition-all duration-300 [&.is-open]:visible [&.is-open]:translate-y-0 [&.is-open]:opacity-100"
          >
            <div class="glass rounded-3xl p-4 shadow-lift">
              {
                resources.map((r) => (
                  <a
                    href={r.href}
                    class="group flex items-start gap-3 rounded-2xl p-3 transition-colors hover:bg-accent-400/10"
                  >
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand-900 text-accent-400">
                      <Icon name={r.icon} class="h-4.5 w-4.5" />
                    </span>
                    <span>
                      <span class="block text-sm font-semibold text-navy-900 group-hover:text-brand-800 dark:text-white dark:group-hover:text-accent-300">
                        {r.name}
                      </span>
                      <span class="block text-[11px] text-navy-900/45 dark:text-white/40">{r.desc}</span>
                    </span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <a href="/a-propos" class="btn-ghost btn rounded-xl px-3.5 py-2 text-sm">À propos</a>
        <a href="/contact" class="btn-ghost btn rounded-xl px-3.5 py-2 text-sm">Contact</a>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-2">
        <button
          data-theme-toggle
          class="hidden h-9 w-9 items-center justify-center rounded-xl text-navy-900/60 transition-colors hover:bg-navy-900/5 hover:text-navy-900 sm:flex dark:text-white/60 dark:hover:bg-white/10 dark:hover:text-white"
          aria-label="Changer de thème"
        >
          <span class="dark:hidden"><Icon name="SunMedium" class="h-4.5 w-4.5" /></span>
          <span class="hidden dark:block"><Icon name="MoonStar" class="h-4.5 w-4.5" /></span>
        </button>
        <a href="/rendez-vous" class="btn-primary btn-md hidden sm:inline-flex">
          <Icon name="Calendar" class="h-4 w-4" />
          Prendre RDV
        </a>
        <button
          id="mobile-menu-btn"
          aria-expanded="false"
          aria-label="Ouvrir le menu"
          class="flex h-10 w-10 items-center justify-center rounded-xl text-navy-900 lg:hidden dark:text-white"
        >
          <Icon name="Menu" class="h-5 w-5" />
        </button>
      </div>
    </nav>
  </div>

  <!-- Menu mobile -->
  <div
    id="mobile-menu"
    class="invisible fixed inset-x-0 top-[70px] bottom-0 z-40 translate-y-3 overflow-y-auto px-4 pb-8 opacity-0 transition-all duration-300 lg:hidden [&.is-open]:visible [&.is-open]:translate-y-0 [&.is-open]:opacity-100"
    data-lenis-prevent
  >
    <div class="mx-auto max-w-lg space-y-1 rounded-3xl border border-navy-900/8 bg-white/97 p-4 shadow-lift backdrop-blur-2xl dark:border-white/10 dark:bg-navy-950/97">
      <a href="/" class="block rounded-2xl px-4 py-3 text-sm font-semibold text-navy-900 dark:text-white">Accueil</a>

      <div class="group" data-acc>
        <button
          data-acc-btn
          class="flex w-full items-center justify-between rounded-2xl px-4 py-3 text-sm font-semibold text-navy-900 dark:text-white"
        >
          Destinations
          <span class="text-accent-600 transition-transform group-[.is-open]:rotate-45 dark:text-accent-400"><Icon name="Plus" class="h-4 w-4" /></span>
        </button>
        <div class="hidden space-y-0.5 pb-2 pl-4 group-[.is-open]:block">
          {
            destinations.map((d) => (
              <a
                href={`/${d.slug}`}
                class="flex items-center gap-2.5 rounded-xl px-4 py-2 text-sm text-navy-900/70 dark:text-white/70"
              >
                <Flag cc={d.cc} /> {d.name}
              </a>
            ))
          }
          <a href="/destinations" class="block px-4 py-2 text-sm font-bold text-brand-800 dark:text-accent-300"
            >Toutes les destinations →</a
          >
        </div>
      </div>

      <div class="group" data-acc>
        <button
          data-acc-btn
          class="flex w-full items-center justify-between rounded-2xl px-4 py-3 text-sm font-semibold text-navy-900 dark:text-white"
        >
          Outils
          <span class="text-accent-600 transition-transform group-[.is-open]:rotate-45 dark:text-accent-400"><Icon name="Plus" class="h-4 w-4" /></span>
        </button>
        <div class="hidden space-y-0.5 pb-2 pl-4 group-[.is-open]:block">
          {
            tools.map((t) => (
              <a
                href={`/outils/${t.slug}`}
                class="flex items-center gap-2.5 rounded-xl px-4 py-2 text-sm text-navy-900/70 dark:text-white/70"
              >
                <Icon name={t.icon} class="h-4 w-4 text-brand-700 dark:text-accent-400" /> {t.name}
              </a>
            ))
          }
        </div>
      </div>

      <a href="/blog" class="block rounded-2xl px-4 py-3 text-sm font-semibold text-navy-900 dark:text-white">Blog</a>
      <a href="/a-propos" class="block rounded-2xl px-4 py-3 text-sm font-semibold text-navy-900 dark:text-white">À propos</a>
      <a href="/contact" class="block rounded-2xl px-4 py-3 text-sm font-semibold text-navy-900 dark:text-white">Contact</a>

      <div class="flex items-center gap-2 pt-2">
        <a href="/rendez-vous" class="btn-primary btn-md flex-1">Prendre rendez-vous</a>
        <button
          data-theme-toggle
          class="flex h-11 w-11 items-center justify-center rounded-xl border border-navy-900/10 text-navy-900/70 dark:border-white/15 dark:text-white/70"
          aria-label="Changer de thème"
        >
          <span class="dark:hidden"><Icon name="SunMedium" class="h-4.5 w-4.5" /></span>
          <span class="hidden dark:block"><Icon name="MoonStar" class="h-4.5 w-4.5" /></span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Espace sous le header fixe -->
<div class="h-[76px]" aria-hidden="true"></div>
