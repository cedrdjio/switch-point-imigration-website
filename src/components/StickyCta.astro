---
import { whatsappLink } from '@/data/site';
import Icon from '@/components/Icon.astro';
---

<!-- CTA flottant : WhatsApp + RDV -->
<div class="fixed bottom-5 right-5 z-40 flex flex-col items-end gap-3">
  <a
    href={whatsappLink()}
    target="_blank"
    rel="noopener"
    aria-label="Réserver une consultation via WhatsApp"
    class="flex h-[52px] w-[52px] items-center justify-center rounded-full bg-emerald-500 text-white shadow-lift transition-transform hover:scale-110"
  >
    <Icon name="MessageCircle" class="h-6 w-6" />
  </a>
  <a href="/rendez-vous" class="btn-primary btn-md shadow-lift">
    <Icon name="Calendar" class="h-4 w-4" />
    Prendre RDV
  </a>
</div>
