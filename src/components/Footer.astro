---
import { SITE, whatsappLink } from '@/data/site';
import { destinations } from '@/data/destinations';
import { tools } from '@/data/tools';
import Icon from '@/components/Icon.astro';
import Flag from '@/components/Flag.astro';

const year = new Date().getFullYear();
---

<footer class="relative mt-24 overflow-hidden bg-navy-950 text-white">
  <div class="aurora -top-40 left-1/4 h-96 w-96 bg-brand-700/40"></div>
  <div class="aurora -right-20 top-20 h-80 w-80 bg-accent-500/10"></div>

  <!-- Bande CTA -->
  <div class="relative mx-auto max-w-7xl px-4 pt-20 sm:px-6">
    <div class="relative overflow-hidden rounded-4xl" data-reveal>
      <div class="media-parallax absolute inset-0">
        <img src="/images/team-canada.png" alt="" class="opacity-25" loading="lazy" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-br from-navy-950/85 via-brand-900/80 to-navy-950/90"></div>
      <div class="relative p-8 text-center sm:p-14">
        <p class="eyebrow !text-accent-400">Prêt à changer de continent ?</p>
        <h2 class="font-display mx-auto mt-3 max-w-2xl text-3xl font-bold tracking-tight uppercase sm:text-4xl">
          Votre projet mérite une <span class="text-gradient">stratégie</span>, pas un pari.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-white/65">
          Consultation d’évaluation gratuite. Un expert analyse votre profil et vous propose le programme le plus réaliste.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href="/rendez-vous" class="btn-primary btn-lg">
            <Icon name="Calendar" class="h-4.5 w-4.5" />
            Réserver ma consultation
          </a>
          <a href={whatsappLink()} target="_blank" rel="noopener" class="btn-secondary btn-lg !border-white/20 !bg-white/5 !text-white hover:!border-emerald-400/60">
            <Icon name="MessageCircle" class="h-4.5 w-4.5 text-emerald-400" />
            WhatsApp direct
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Liens -->
  <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-3">
          <img src="/images/logo.png" alt="" width="44" height="44" class="h-11 w-11 object-contain" />
          <span class="flex flex-col leading-tight">
            <span class="font-display text-lg font-bold">SwitchPoint</span>
            <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-accent-400">Immigration Agency</span>
          </span>
        </a>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/55">
          {SITE.description}
        </p>
        <div class="mt-6 flex gap-2.5">
          {
            Object.entries(SITE.socials).map(([name, url]) => (
              <a
                href={url}
                target="_blank"
                rel="noopener"
                aria-label={name}
                class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 text-[10px] font-bold uppercase text-white/60 transition-colors hover:border-accent-400/60 hover:text-accent-300"
              >
                {name.slice(0, 2)}
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <p class="text-xs font-bold tracking-[0.18em] uppercase text-white/40">Destinations</p>
        <ul class="mt-4 space-y-2.5">
          {
            destinations.slice(0, 6).map((d) => (
              <li>
                <a href={`/${d.slug}`} class="flex items-center gap-2 text-sm text-white/60 transition-colors hover:text-accent-300">
                  <Flag cc={d.cc} class="h-[12px] w-4" /> {d.name}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/destinations" class="text-sm font-bold text-accent-400 hover:text-accent-300">Tout voir →</a>
          </li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-bold tracking-[0.18em] uppercase text-white/40">Outils</p>
        <ul class="mt-4 space-y-2.5">
          {
            tools.slice(0, 6).map((t) => (
              <li>
                <a href={`/outils/${t.slug}`} class="text-sm text-white/60 transition-colors hover:text-accent-300">
                  {t.name}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/outils" class="text-sm font-bold text-accent-400 hover:text-accent-300">Tous les outils →</a>
          </li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-bold tracking-[0.18em] uppercase text-white/40">Contact</p>
        <ul class="mt-4 space-y-3 text-sm text-white/60">
          <li>
            <a href={`tel:${SITE.phone}`} class="flex items-center gap-2.5 transition-colors hover:text-accent-300">
              <Icon name="Phone" class="h-4 w-4 shrink-0 text-accent-400" /> {SITE.phoneDisplay}
            </a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`} class="flex items-center gap-2.5 break-all transition-colors hover:text-accent-300">
              <Icon name="Mail" class="h-4 w-4 shrink-0 text-accent-400" /> {SITE.email}
            </a>
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="MapPin" class="mt-0.5 h-4 w-4 shrink-0 text-accent-400" /> {SITE.address}
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="Clock" class="mt-0.5 h-4 w-4 shrink-0 text-accent-400" /> {SITE.hours}
          </li>
          <li>
            <a href="/rendez-vous" class="font-bold text-accent-400 hover:text-accent-300">Prendre rendez-vous →</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-xs text-white/40 sm:flex-row">
      <p>© {year} {SITE.name}. Tous droits réservés.</p>
      <p>
        Les informations publiées sont indicatives et ne constituent pas un avis juridique. Frais gouvernementaux susceptibles d’évoluer.
      </p>
    </div>
  </div>
</footer>
