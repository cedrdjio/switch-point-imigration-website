---
import { SITE, whatsappLink } from '@/data/site';
import { destinations } from '@/data/destinations';
import { tools } from '@/data/tools';

const year = new Date().getFullYear();
---

<footer class="relative mt-24 overflow-hidden bg-navy-950 text-white">
  <div class="aurora -top-40 left-1/4 h-96 w-96 bg-brand-700/30"></div>
  <div class="aurora -right-20 top-20 h-80 w-80 bg-brand-500/20"></div>

  <!-- Bande CTA -->
  <div class="relative mx-auto max-w-7xl px-4 pt-20 sm:px-6">
    <div class="glass-deep rounded-4xl p-8 text-center sm:p-14" data-reveal>
      <p class="eyebrow !text-brand-300">Prêt à changer de continent ?</p>
      <h2 class="font-display mx-auto mt-3 max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">
        Votre projet d’immigration mérite une stratégie, pas un pari.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-white/60">
        Consultation d’évaluation gratuite. Un expert analyse votre profil et vous propose le programme le plus réaliste.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/rendez-vous" class="btn-primary btn-lg">Réserver ma consultation</a>
        <a href={whatsappLink()} target="_blank" rel="noopener" class="btn-secondary btn-lg !border-white/20 !bg-white/5 !text-white hover:!border-emerald-400/60">
          <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.8 1.4 1.8 2.2 1.2 1.1 2.3 1.4 2.6 1.6.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .7-.2 1.3Z"/></svg>
          WhatsApp direct
        </a>
      </div>
    </div>
  </div>

  <!-- Liens -->
  <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-3">
          <img src="/images/logo.png" alt="" width="44" height="44" class="h-11 w-11 object-contain" />
          <span class="flex flex-col leading-tight">
            <span class="font-display text-lg font-bold">Switch Point</span>
            <span class="text-[10px] font-semibold tracking-[0.2em] uppercase text-brand-400">Immigration Agency</span>
          </span>
        </a>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/55">
          {SITE.description}
        </p>
        <div class="mt-6 flex gap-2.5">
          {
            Object.entries(SITE.socials).map(([name, url]) => (
              <a
                href={url}
                target="_blank"
                rel="noopener"
                aria-label={name}
                class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 text-xs font-bold uppercase text-white/60 transition-colors hover:border-brand-400/60 hover:text-brand-300"
              >
                {name.slice(0, 2)}
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <p class="text-xs font-bold tracking-[0.18em] uppercase text-white/40">Destinations</p>
        <ul class="mt-4 space-y-2.5">
          {
            destinations.slice(0, 6).map((d) => (
              <li>
                <a href={`/${d.slug}`} class="text-sm text-white/60 transition-colors hover:text-brand-300">
                  {d.flag} {d.name}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/destinations" class="text-sm font-semibold text-brand-400 hover:text-brand-300">Tout voir →</a>
          </li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-bold tracking-[0.18em] uppercase text-white/40">Outils</p>
        <ul class="mt-4 space-y-2.5">
          {
            tools.slice(0, 6).map((t) => (
              <li>
                <a href={`/outils/${t.slug}`} class="text-sm text-white/60 transition-colors hover:text-brand-300">
                  {t.name}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/outils" class="text-sm font-semibold text-brand-400 hover:text-brand-300">Tous les outils →</a>
          </li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-bold tracking-[0.18em] uppercase text-white/40">Contact</p>
        <ul class="mt-4 space-y-2.5 text-sm text-white/60">
          <li>
            <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="transition-colors hover:text-brand-300">📞 {SITE.phoneDisplay}</a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`} class="break-all transition-colors hover:text-brand-300">✉️ {SITE.email}</a>
          </li>
          <li>📍 {SITE.address}</li>
          <li>
            <a href="/rendez-vous" class="font-semibold text-brand-400 hover:text-brand-300">Prendre rendez-vous →</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-xs text-white/40 sm:flex-row">
      <p>© {year} {SITE.name}. Tous droits réservés.</p>
      <p>
        Les informations publiées sont indicatives et ne constituent pas un avis juridique. Frais gouvernementaux susceptibles d’évoluer.
      </p>
    </div>
  </div>
</footer>
