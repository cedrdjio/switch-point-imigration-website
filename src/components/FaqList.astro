---
import type { FaqItem } from '@/data/destinations';

interface Props {
  items: FaqItem[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---

<div class={`space-y-3 ${className}`} data-accordion="single">
  {
    items.map((item) => (
      <div class="bento group !rounded-2xl" data-accordion-item>
        <button
          data-accordion-btn
          class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left sm:px-6"
        >
          <span class="text-sm font-semibold text-navy-900 sm:text-base dark:text-white">{item.q}</span>
          <span
            aria-hidden="true"
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-500/10 text-brand-700 transition-transform duration-300 group-[.is-open]:rotate-45 dark:text-brand-300"
          >
            +
          </span>
        </button>
        <div class="grid grid-rows-[0fr] transition-all duration-400 group-[.is-open]:grid-rows-[1fr]">
          <div class="overflow-hidden">
            <p class="px-5 pb-5 text-sm leading-relaxed text-navy-900/65 sm:px-6 dark:text-white/60">{item.a}</p>
          </div>
        </div>
      </div>
    ))
  }
</div>
