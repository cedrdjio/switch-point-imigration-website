---
import { testimonials } from '@/data/testimonials';
---

<div class="swiper testimonials-swiper !overflow-visible" data-reveal>
  <div class="swiper-wrapper">
    {
      testimonials.map((t) => (
        <div class="swiper-slide !h-auto">
          <figure class="bento flex h-full flex-col gap-5 p-7">
            <div class="flex items-center gap-1 text-amber-400" aria-label={`${t.rating} étoiles`}>
              {Array.from({ length: t.rating }).map(() => (
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
                </svg>
              ))}
            </div>
            <blockquote class="flex-1 text-[15px] leading-relaxed text-navy-900/75 dark:text-white/70">
              «&nbsp;{t.quote}&nbsp;»
            </blockquote>
            <figcaption class="flex items-center gap-3 border-t border-navy-900/8 pt-5 dark:border-white/10">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-gradient-to-br from-brand-500 to-brand-800 font-display text-sm font-bold text-white">
                {t.name.charAt(0)}
              </span>
              <span>
                <span class="block text-sm font-bold text-navy-900 dark:text-white">{t.name}</span>
                <span class="block text-xs text-navy-900/50 dark:text-white/45">
                  {t.origin} → {t.destination} {t.flag}
                </span>
                <span class="mt-0.5 block text-[11px] font-semibold text-brand-600 dark:text-brand-400">{t.program}</span>
              </span>
            </figcaption>
          </figure>
        </div>
      ))
    }
  </div>
  <div class="swiper-pagination !relative mt-8"></div>
</div>

<style is:global>
  .testimonials-swiper .swiper-pagination-bullet {
    background: rgb(0 64 144 / 0.3);
    opacity: 1;
    width: 8px;
    height: 8px;
    transition: all 0.3s;
  }
  .dark .testimonials-swiper .swiper-pagination-bullet {
    background: rgb(255 255 255 / 0.25);
  }
  .testimonials-swiper .swiper-pagination-bullet-active {
    background: #0060b0;
    width: 24px;
    border-radius: 6px;
  }
  .dark .testimonials-swiper .swiper-pagination-bullet-active {
    background: #38acf0;
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Pagination, Autoplay } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';

  new Swiper('.testimonials-swiper', {
    modules: [Pagination, Autoplay],
    slidesPerView: 1,
    spaceBetween: 20,
    autoplay: { delay: 4500, pauseOnMouseEnter: true },
    pagination: { el: '.testimonials-swiper .swiper-pagination', clickable: true },
    breakpoints: {
      640: { slidesPerView: 2 },
      1024: { slidesPerView: 3 },
    },
  });
</script>
