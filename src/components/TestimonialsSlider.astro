---
import { testimonials } from '@/data/testimonials';
import Icon from '@/components/Icon.astro';
import Flag from '@/components/Flag.astro';
---

<div class="swiper testimonials-swiper !overflow-visible" data-reveal>
  <div class="swiper-wrapper">
    {
      testimonials.map((t) => (
        <div class="swiper-slide !h-auto">
          <figure class="bento flex h-full flex-col gap-5 p-7">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-1 text-accent-500" aria-label={`${t.rating} étoiles`}>
                {Array.from({ length: t.rating }).map(() => (
                  <Icon name="Star" class="h-4 w-4 fill-current" />
                ))}
              </div>
              <Icon name="Quote" class="h-6 w-6 text-brand-200 dark:text-white/15" />
            </div>
            <blockquote class="flex-1 text-[15px] leading-relaxed text-navy-900/75 dark:text-white/70">
              «&nbsp;{t.quote}&nbsp;»
            </blockquote>
            <figcaption class="flex items-center gap-3 border-t border-navy-900/8 pt-5 dark:border-white/10">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-900 font-display text-sm font-bold text-accent-400">
                {t.name.charAt(0)}
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-bold text-navy-900 dark:text-white">{t.name}</span>
                <span class="flex items-center gap-1.5 text-xs text-navy-900/50 dark:text-white/45">
                  {t.origin} → {t.destination} <Flag cc={t.cc} class="h-[11px] w-4" />
                </span>
                <span class="mt-0.5 block text-[11px] font-bold text-brand-700 dark:text-accent-400">{t.program}</span>
              </span>
            </figcaption>
          </figure>
        </div>
      ))
    }
  </div>
  <div class="swiper-pagination !relative mt-8"></div>
</div>

<style is:global>
  .testimonials-swiper .swiper-pagination-bullet {
    background: rgb(30 48 84 / 0.3);
    opacity: 1;
    width: 8px;
    height: 8px;
    transition: all 0.3s;
  }
  .dark .testimonials-swiper .swiper-pagination-bullet {
    background: rgb(255 255 255 / 0.25);
  }
  .testimonials-swiper .swiper-pagination-bullet-active {
    background: #f9a807;
    width: 24px;
    border-radius: 6px;
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Pagination, Autoplay } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';

  new Swiper('.testimonials-swiper', {
    modules: [Pagination, Autoplay],
    slidesPerView: 1,
    spaceBetween: 20,
    autoplay: { delay: 4500, pauseOnMouseEnter: true },
    pagination: { el: '.testimonials-swiper .swiper-pagination', clickable: true },
    breakpoints: {
      640: { slidesPerView: 2 },
      1024: { slidesPerView: 3 },
    },
  });
</script>
