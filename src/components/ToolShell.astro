---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import { whatsappLink } from '@/data/site';

interface Props {
  /** Nom d'icône Lucide */
  icon: string;
  name: string;
  intro: string;
  disclaimer?: string;
}
const { icon, name, intro, disclaimer } = Astro.props;

const crumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Outils', url: '/outils' },
  { name, url: Astro.url.pathname },
];
---

<section class="relative overflow-hidden pt-10 pb-16">
  <div class="aurora -top-24 left-1/4 h-96 w-96 bg-brand-500/18"></div>
  <div class="relative mx-auto max-w-5xl px-4 sm:px-6">
    <Breadcrumbs crumbs={crumbs} />
    <div class="mt-8 text-center" data-reveal>
      <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-3xl bg-brand-900 text-accent-400 shadow-lift">
        <Icon name={icon} class="h-7 w-7" />
      </span>
      <h1 class="font-display mt-5 text-3xl font-bold tracking-tight uppercase text-navy-900 sm:text-5xl dark:text-white">{name}</h1>
      <p class="section-sub mx-auto text-center">{intro}</p>
    </div>

    <div class="mt-10" data-reveal data-reveal-delay="0.1">
      <slot />
    </div>

    {
      disclaimer && (
        <p class="mx-auto mt-8 max-w-2xl text-center text-xs leading-relaxed text-navy-900/40 dark:text-white/35">
          {disclaimer}
        </p>
      )
    }

    <div class="bento mt-12 flex flex-col items-center gap-4 p-8 text-center sm:flex-row sm:justify-between sm:text-left" data-reveal>
      <div>
        <h2 class="font-display text-lg font-bold text-navy-900 dark:text-white">Besoin d'un œil expert sur votre résultat ?</h2>
        <p class="mt-1 text-sm text-navy-900/55 dark:text-white/50">Un consultant vérifie votre profil et vous propose la stratégie optimale — gratuitement.</p>
      </div>
      <div class="flex shrink-0 gap-3">
        <a href="/rendez-vous" class="btn-primary btn-md">
          <Icon name="Calendar" class="h-4 w-4" />
          Prendre RDV
        </a>
        <a href={whatsappLink()} target="_blank" rel="noopener" class="btn-secondary btn-md">
          <Icon name="MessageCircle" class="h-4 w-4 text-emerald-500" />
          WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
