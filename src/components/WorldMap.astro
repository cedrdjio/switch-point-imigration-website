---
/**
 * Carte du monde stylisée : réseau de vols animés depuis l'Afrique
 * vers les destinations couvertes. Projection équirectangulaire simplifiée.
 */
const hub = { x: 527, y: 290, name: 'Afrique' };
const cities = [
  { x: 295, y: 142, name: 'Canada', flag: '🇨🇦', href: '/canada' },
  { x: 507, y: 129, name: 'France', flag: '🇫🇷', href: '/france' },
  { x: 570, y: 109, name: 'Lituanie', flag: '🇱🇹', href: '/lituanie' },
  { x: 565, y: 152, name: 'Bulgarie', flag: '🇧🇬', href: '/bulgarie' },
  { x: 604, y: 100, name: 'Russie', flag: '🇷🇺', href: '/russie' },
  { x: 583, y: 118, name: 'Biélorussie', flag: '🇧🇾', href: '/bielorussie' },
  { x: 900, y: 420, name: 'Australie', flag: '🇦🇺', href: '/australie' },
  { x: 968, y: 445, name: 'Nouvelle-Zélande', flag: '🇳🇿', href: '/nouvelle-zelande' },
];

const arc = (x1: number, y1: number, x2: number, y2: number) => {
  const mx = (x1 + x2) / 2;
  const my = Math.min(y1, y2) - Math.abs(x2 - x1) * 0.22 - 20;
  return `M ${x1} ${y1} Q ${mx} ${my} ${x2} ${y2}`;
};
---

<div class="relative w-full select-none" aria-hidden="true">
  <svg viewBox="80 40 940 470" fill="none" class="w-full">
    <!-- Grille de points -->
    <defs>
      <pattern id="dots" x="0" y="0" width="26" height="26" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1.4" fill="currentColor" class="text-brand-500/[0.13]" />
      </pattern>
      <linearGradient id="flight" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#38acf0" stop-opacity="0.1" />
        <stop offset="50%" stop-color="#38acf0" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#8ecdff" stop-opacity="0.2" />
      </linearGradient>
      <radialGradient id="hubGlow">
        <stop offset="0%" stop-color="#38acf0" stop-opacity="0.5" />
        <stop offset="100%" stop-color="#38acf0" stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect x="80" y="40" width="940" height="470" fill="url(#dots)" rx="24" />

    <!-- Continents stylisés -->
    <g class="text-brand-700/15 dark:text-brand-300/12" fill="currentColor">
      <!-- Amérique du Nord -->
      <path d="M150 90 Q220 60 300 78 Q350 88 340 130 Q325 175 285 190 Q250 205 225 185 Q170 175 150 140 Z" />
      <!-- Amérique du Sud -->
      <path d="M280 260 Q320 245 340 275 Q355 315 335 365 Q318 410 295 415 Q272 400 268 350 Q262 300 280 260 Z" />
      <!-- Europe -->
      <path d="M480 100 Q530 82 585 92 Q625 100 618 135 Q600 165 555 168 Q505 172 488 145 Q472 122 480 100 Z" />
      <!-- Afrique -->
      <path d="M470 200 Q520 180 570 200 Q600 225 588 280 Q575 340 540 380 Q510 405 488 375 Q460 330 456 275 Q452 230 470 200 Z" />
      <!-- Asie / Russie -->
      <path d="M640 80 Q740 60 850 85 Q910 100 895 150 Q870 205 800 220 Q720 235 670 200 Q625 160 640 80 Z" />
      <!-- Australie -->
      <path d="M855 380 Q905 362 945 385 Q968 405 950 435 Q925 458 885 450 Q848 438 845 410 Q843 392 855 380 Z" />
    </g>

    <!-- Trajectoires de vol -->
    <g>
      {
        cities.map((c, i) => (
          <>
            <path
              d={arc(hub.x, hub.y, c.x, c.y)}
              stroke="url(#flight)"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-dasharray="200"
              class="animate-dash"
              style={`animation-delay: ${i * 0.55}s; animation-duration: ${3.2 + (i % 3) * 0.6}s`}
            />
            <circle cx={c.x} cy={c.y} r="4" fill="#38acf0" class="animate-pulse-soft" style={`animation-delay:${i * 0.3}s`} />
            <circle cx={c.x} cy={c.y} r="9" fill="none" stroke="#38acf0" stroke-opacity="0.3" stroke-width="1" />
          </>
        ))
      }
    </g>

    <!-- Hub Afrique -->
    <circle cx={hub.x} cy={hub.y} r="34" fill="url(#hubGlow)" />
    <circle cx={hub.x} cy={hub.y} r="7" fill="#0060b0" stroke="#8ecdff" stroke-width="2.5" />
  </svg>

  <!-- Étiquettes flottantes -->
  <a href="/canada" class="glass absolute left-[16%] top-[16%] hidden items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-navy-900 shadow-soft transition-transform hover:scale-105 sm:flex dark:text-white animate-float">
    🇨🇦 Canada
  </a>
  <a href="/france" class="glass absolute left-[43%] top-[8%] hidden items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-navy-900 shadow-soft transition-transform hover:scale-105 sm:flex dark:text-white animate-float" style="animation-delay:1.2s">
    🇫🇷 France
  </a>
  <a href="/australie" class="glass absolute right-[8%] top-[62%] hidden items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-navy-900 shadow-soft transition-transform hover:scale-105 sm:flex dark:text-white animate-float" style="animation-delay:2.1s">
    🇦🇺 Australie
  </a>
  <div class="glass absolute left-[42%] top-[52%] hidden items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-brand-700 shadow-soft sm:flex dark:text-brand-300">
    📍 Vous êtes ici
  </div>
</div>
