---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { SITE, whatsappLink } from '@/data/site';

const crumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Contact', url: '/contact' },
];

const channels = [
  {
    icon: '💬',
    title: 'WhatsApp',
    desc: 'Le canal le plus rapide — réponse en moins d’une heure ouvrée.',
    cta: 'Ouvrir WhatsApp',
    href: whatsappLink(),
    external: true,
    highlight: true,
  },
  {
    icon: '📞',
    title: 'Téléphone',
    desc: `Lun – Sam, 8h – 18h : ${SITE.phoneDisplay}`,
    cta: 'Appeler maintenant',
    href: `tel:${SITE.phone.replace(/\s/g, '')}`,
    external: false,
    highlight: false,
  },
  {
    icon: '✉️',
    title: 'Email',
    desc: 'Pour les demandes détaillées avec documents joints.',
    cta: 'Écrire un email',
    href: `mailto:${SITE.email}?subject=${encodeURIComponent('Demande d’information — projet d’immigration')}`,
    external: false,
    highlight: false,
  },
  {
    icon: '📅',
    title: 'Rendez-vous',
    desc: 'Consultation d’évaluation gratuite, au bureau ou en visio.',
    cta: 'Réserver un créneau',
    href: '/rendez-vous',
    external: false,
    highlight: false,
  },
];
---

<Base
  title="Contact — WhatsApp, téléphone, email | Switch Point Immigration"
  description={`Contactez Switch Point Immigration : WhatsApp, téléphone ${SITE.phoneDisplay}, email ou rendez-vous gratuit à ${SITE.address}.`}
  breadcrumbs={crumbs}
>
  <section class="relative overflow-hidden pt-10 pb-16">
    <div class="aurora -top-24 right-1/4 h-96 w-96 bg-brand-500/18"></div>
    <div class="relative mx-auto max-w-5xl px-4 sm:px-6">
      <Breadcrumbs crumbs={crumbs} />
      <div class="mt-8 max-w-2xl" data-reveal>
        <p class="eyebrow">Contact</p>
        <h1 class="font-display mt-3 text-4xl font-bold tracking-tight text-navy-900 sm:text-5xl dark:text-white">
          Parlons de votre projet. <span class="text-gradient">Vraiment.</span>
        </h1>
        <p class="section-sub">
          Pas de robot, pas de formulaire sans réponse : choisissez votre canal, un conseiller vous répond.
        </p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2" data-reveal-group>
        {
          channels.map((c) => (
            <a
              href={c.href}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener' : undefined}
              class={`bento bento-hover group p-7 ${c.highlight ? 'bg-gradient-to-br from-emerald-500/10 to-brand-500/10' : ''}`}
              data-reveal-item
            >
              <div class="flex items-center justify-between">
                <span class="text-3xl">{c.icon}</span>
                {c.highlight && <span class="badge">Recommandé</span>}
              </div>
              <h2 class="font-display mt-4 text-xl font-bold text-navy-900 dark:text-white">{c.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-navy-900/55 dark:text-white/50">{c.desc}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-brand-700 transition-transform duration-300 group-hover:translate-x-1 dark:text-brand-300">
                {c.cta} →
              </span>
            </a>
          ))
        }
      </div>

      <div class="bento mt-4 p-7" data-reveal>
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="font-display text-lg font-bold text-navy-900 dark:text-white">📍 Nos bureaux</h2>
            <p class="mt-1 text-sm text-navy-900/55 dark:text-white/50">{SITE.address} — sur rendez-vous uniquement.</p>
          </div>
          <div class="flex gap-6 text-sm">
            <div>
              <p class="font-bold text-navy-900 dark:text-white">Lun – Ven</p>
              <p class="text-navy-900/55 dark:text-white/50">8h00 – 18h00</p>
            </div>
            <div>
              <p class="font-bold text-navy-900 dark:text-white">Samedi</p>
              <p class="text-navy-900/55 dark:text-white/50">9h00 – 14h00</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
