---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { articles, categories } from '@/data/blog';

const crumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Blog', url: '/blog' },
];

const fmtDate = (d: string) =>
  new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  title="Blog immigration — Actualités, guides et analyses | SwitchPoint"
  description="Actualités Express Entry, calendrier Campus France, permis européens : les analyses de nos consultants pour garder un coup d'avance sur les règles d'immigration."
  breadcrumbs={crumbs}
>
  <section class="relative overflow-hidden pt-10 pb-8">
    <div class="aurora -top-24 left-1/3 h-96 w-96 bg-brand-500/18"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      <Breadcrumbs crumbs={crumbs} />
      <div class="mt-8 max-w-3xl" data-reveal>
        <p class="eyebrow">Le blog</p>
        <h1 class="font-display mt-3 text-4xl font-bold tracking-tight uppercase text-navy-900 sm:text-5xl dark:text-white">
          Les règles changent. <span class="text-gradient">Restez devant.</span>
        </h1>
        <p class="section-sub">
          Analyses, calendriers et décryptages écrits par nos consultants — pas des copies de communiqués.
        </p>
      </div>

      <!-- Filtres -->
      <div class="mt-10 flex flex-wrap gap-2" data-reveal id="guides">
        <button data-cat="all" class="blog-chip is-active rounded-full border border-brand-900 bg-brand-900 px-4 py-2 text-xs font-bold text-white sm:text-sm">Tout</button>
        {
          categories.map((c) => (
            <button
              data-cat={c}
              class="blog-chip rounded-full border border-navy-900/10 px-4 py-2 text-xs font-bold text-navy-900/65 transition-all hover:border-accent-500 sm:text-sm dark:border-white/12 dark:text-white/60"
            >
              {c}
            </button>
          ))
        }
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {
          articles.map((a) => (
            <a
              href={`/blog/${a.slug}`}
              data-article
              data-cats={a.categories.join('|')}
              class="bento bento-hover group flex flex-col overflow-hidden"
              data-reveal-item
            >
              <div class={`media-parallax relative h-44 bg-gradient-to-br ${a.gradient}`}>
                <img src={a.image} alt="" loading="lazy" data-fallback class="transition-transform duration-700 group-hover:scale-105" />
                <span class="badge-navy absolute top-3 left-3 !bg-navy-950/70">{a.category}</span>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <div class="flex flex-wrap items-center gap-2 text-xs text-navy-900/45 dark:text-white/40">
                  <span>{fmtDate(a.date)}</span>
                  <span>· {a.readTime}</span>
                </div>
                <h2 class="font-display mt-3 flex-1 text-lg leading-snug font-bold text-navy-900 group-hover:text-brand-800 dark:text-white dark:group-hover:text-accent-300">
                  {a.title}
                </h2>
                <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-navy-900/55 dark:text-white/50">{a.excerpt}</p>
              </div>
            </a>
          ))
        }
      </div>
      <p id="blog-empty" class="mt-8 hidden text-center text-sm text-navy-900/50 dark:text-white/45">
        Aucun article dans cette catégorie pour le moment.
      </p>
    </div>
  </section>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.blog-chip');
  const cards = document.querySelectorAll<HTMLElement>('[data-article]');
  const empty = document.getElementById('blog-empty')!;
  const activeCls = ['border-brand-900', 'bg-brand-900', 'text-white'];

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove(...activeCls));
      chip.classList.add(...activeCls);
      const cat = chip.dataset.cat!;
      let shown = 0;
      cards.forEach((card) => {
        const match = cat === 'all' || (card.dataset.cats ?? '').split('|').includes(cat);
        card.classList.toggle('hidden', !match);
        if (match) shown++;
      });
      empty.classList.toggle('hidden', shown > 0);
    })
  );
</script>
