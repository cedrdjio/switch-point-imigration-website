<script>
  // Affiche les résultats de recherche seulement quand une requête existe
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const results = document.querySelector<HTMLElement>('[data-search-results]');
  if (input && results) {
    const items = results.querySelectorAll<HTMLElement>('[data-search-item]');
    const toggle = () => {
      const has = input.value.trim().length > 0;
      items.forEach((i) => (i.style.display = has && !i.classList.contains('hidden') ? 'flex' : 'none'));
      const empty = results.querySelector<HTMLElement>('[data-search-empty]');
      if (empty && !has) empty.classList.add('hidden');
    };
    input.addEventListener('input', () => requestAnimationFrame(toggle));
    toggle();
  }
</script>
